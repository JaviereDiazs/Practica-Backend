    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
